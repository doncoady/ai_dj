# Gemini Multimodal Live API key
GEMINI_API_KEY=your_gemini_api_key_here

# Directory containing your local music files
MUSIC_DIR=C:\Users\username\Music

# Optional: directory containing your local audiobooks. Each book is a folder
# of chapter files (Author\Book\01.mp3 …, "CD 1"/"CD 2" sub-folders are merged)
# or a single .m4b/.mp3 file. Leave unset to hide the Audiobooks feature.
AUDIOBOOKS_DIR=C:\Users\username\Audiobooks

# Streaming tab: nothing to configure. Apple Music / Deezer previews are
# keyless; YouTube Music uses the third-party tools ytmusicapi + yt-dlp that
# requirements.txt installs.

# Optional: enable search tool (true/false)
USE_SEARCH_TOOL=true

# Optional: online directories for finding radio stations (radio-browser.info)
# and podcasts (Apple podcast search). Keyless; set false to stay offline.
ONLINE_DIRECTORIES=true

# Optional: also search TuneIn's (unofficial) station directory, which covers
# local commercial stations the community directory lacks. Set false to use
# radio-browser.info only.
TUNEIN_DIRECTORY=true

# Console verbosity (both optional). HTTP_ACCESS_LOG=true prints one line per
# HTTP request (track art/stream and static files are always filtered out).
HTTP_ACCESS_LOG=false
LOG_LEVEL=info
